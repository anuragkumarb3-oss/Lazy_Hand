{
  "expo": {
    "name": "LazyHand",
    "slug": "lazyhand",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "lazyhand",
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow LazyHand to check whether nearby shops can deliver to you."
        }
      ],
      "expo-notifications"
    ],
    "android": {
      "package": "com.lazyhand.customer",
      "adaptiveIcon": {
        "backgroundColor": "#FFF1DF"
      }
    },
    "web": {
      "bundler": "metro"
    }
  }
}
