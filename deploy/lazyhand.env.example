# Copy into /etc/lazyhand/lazyhand.env on the VPS; never commit the populated file.
# Local PostgreSQL on this same host; keep port 5432 private and loopback-only.
DATABASE_URL=postgresql://appuser@localhost:5432/appdb
PG_SSL=disable
PG_POOL_MAX=5
# Supabase Auth remains an external dependency for phone OTP in this migration stage.
# Server-only TomTom routing/geocoding key. Do not prefix with NEXT_PUBLIC_.
TOMTOM_API_KEY=

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Direct UPI collection (no payment gateway). Set these to the merchant/business
# UPI ID that should receive customer payments and the payee name shown in UPI
# apps. When UPI_ID is empty the UPI option is disabled at checkout.
# UPI_ID is embedded in each order's QR; it is not secret, but keep it server-side.
UPI_ID=
UPI_PAYEE_NAME=LazyHand
