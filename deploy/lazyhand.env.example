# Copy into /etc/lazyhand/lazyhand.env and fill via the VPS secret manager.
# Do not commit the populated file. Rotate the credential shared in chat first.
DATABASE_URL=
# Set PG_SSL=disable ONLY when PostgreSQL is bound to loopback on this same host.
PG_SSL=disable
PG_POOL_MAX=5
# Supabase Auth remains an external dependency for phone OTP in this migration stage.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
